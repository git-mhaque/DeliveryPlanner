{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delivery Planner v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reporting_owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title",
        "as_of"
      ]
    },
    "periods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/period"
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stream"
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall_health": {
          "enum": [
            "on_track",
            "at_risk",
            "blocked",
            "unknown"
          ]
        },
        "health_note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "changes_since_last_report": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        },
        "decisions_needed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      },
      "required": []
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_audience": {
          "enum": [
            "delivery",
            "executive",
            "backlog_epic"
          ]
        },
        "show_dependencies": {
          "type": "boolean"
        }
      },
      "required": [
        "default_audience",
        "show_dependencies"
      ]
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directory": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "directory"
      ]
    }
  },
  "required": [
    "schema_version",
    "plan",
    "periods",
    "streams",
    "teams",
    "milestones",
    "dependencies",
    "reporting",
    "view",
    "publish"
  ],
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "start": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "id",
        "label",
        "start",
        "end"
      ]
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "stream": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "target_period": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "status": {
          "enum": [
            "not_started",
            "on_track",
            "at_risk",
            "blocked",
            "done"
          ]
        },
        "tag": {
          "enum": [
            "planned",
            "unplanned"
          ]
        },
        "epic_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          },
          "uniqueItems": true
        },
        "owner_team": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "contributing_teams": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outcome": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "target_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "executive_visible": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "stream",
        "target_period",
        "status",
        "tag",
        "epic_ids"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "kind": {
          "enum": [
            "requires",
            "enables",
            "relates_to"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "milestone_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title",
        "severity",
        "owner",
        "milestone_ids",
        "mitigation"
      ]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "due_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "milestone_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "maxLength": 100
          },
          "uniqueItems": true
        },
        "ask": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "title",
        "owner",
        "due_date",
        "status",
        "milestone_ids",
        "ask"
      ]
    }
  }
}
