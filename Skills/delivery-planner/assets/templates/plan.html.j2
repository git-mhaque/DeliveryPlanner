<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="{{ plan.get('summary', 'Multi-team delivery plan') }}">
  <title>{{ plan.title }}</title>
  <style>{{ css | safe }}</style>
</head>
<body>
  <a class="skip-link" href="#view-content">Skip to plan</a>
  <main class="workspace">
    <section class="hero" aria-labelledby="plan-title">
      <div class="hero-copy"><h1 id="plan-title">{{ plan.title }}</h1><p class="hero-summary" id="plan-summary" hidden>{{ plan.get('summary', 'Your outcomes, teams, and dependencies in one place.') }}</p></div>
      <div class="header-actions">
        <button class="button compact-button" id="print-button" type="button"><span aria-hidden="true">↗</span> Print / PDF</button>
        <button class="button icon-button" id="settings-button" type="button" aria-label="Display settings" title="Display settings" aria-haspopup="dialog" aria-controls="settings-dialog" aria-expanded="false"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 3-.6 2.4-2 .9-2.2-.7-2 3.4L4 10.7v2.6l-1.8 1.7 2 3.4 2.2-.7 2 .9L9 21h6l.6-2.4 2-.9 2.2.7 2-3.4-1.8-1.7v-2.6L21.8 9l-2-3.4-2.2.7-2-.9L15 3Z"/><circle cx="12" cy="12" r="3"/></svg></button>
      </div>
      <div class="health-card" id="health-card" hidden></div>
    </section>
    <section class="metrics" aria-label="Full plan milestone counts" id="metrics" hidden></section>
    <div class="navigation-row">
      <nav class="view-tabs" role="tablist" aria-label="Plan views">
        <button type="button" id="tab-delivery" role="tab" data-view="delivery" aria-controls="view-content">▦ <span>Delivery View</span></button>
        <button type="button" id="tab-executive" role="tab" data-view="executive" aria-controls="view-content">◈ <span>Executive View</span></button>
        <button type="button" id="tab-backlog_epic" role="tab" data-view="backlog_epic" aria-controls="view-content">☷ <span>Backlog Epic View</span></button>
      </nav>
      <div class="utility-actions">
        <div class="roadmap-controls" id="roadmap-controls" hidden>
          <button class="button selection-clear" id="clear-selection" type="button" hidden>Clear selection</button>
          <label class="toggle"><input id="show-dependencies" type="checkbox"> Show dependencies</label>
        </div>
        <span class="reporting-date">As of <time id="report-date"{% if plan.as_of %} datetime="{{ plan.as_of }}"{% endif %}>{{ plan.as_of or 'Draft' }}</time></span>
      </div>
    </div>
    <form class="filters" id="filters" aria-label="Filter milestones" onsubmit="return false" hidden>
      <label class="search-filter"><span>SEARCH</span><input id="filter-search" type="search" placeholder="Milestone, outcome or epic…" autocomplete="off"></label>
      <label><span>STREAM</span><select id="filter-stream"><option value="">All streams</option></select></label>
      <label><span>TEAM</span><select id="filter-team"><option value="">All teams</option></select></label>
      <label><span>STATUS</span><select id="filter-status"><option value="">All statuses</option></select></label>
      <label><span>SCOPE</span><select id="filter-tag"><option value="">All work</option></select></label>
      <label><span>PERIOD</span><select id="filter-period"><option value="">All periods</option></select></label>
      <label><span>EPIC</span><select id="filter-epic"><option value="">All epics</option></select></label>
      <button class="button reset-button" id="reset-filters" type="button">Reset</button>
    </form>
    <div id="filter-summary" class="filter-summary" aria-live="polite" hidden></div>
    <section id="view-content" role="tabpanel" tabindex="-1"></section>
    <details id="diagnostics" class="diagnostics"></details>
    <footer class="page-footer"><span>DELIVERY PLANNER <span class="footer-divider">/</span> A shared view of what comes next.</span><span>Renderer {{ version }} · Source {{ fingerprint[:12] }}</span></footer>
    <noscript><section class="no-script"><h2>Milestone register</h2><p>Enable JavaScript for filters, interactive views, and dependency exploration. All data is embedded in this file.</p>{% for milestone in data.milestones %}<article><h3>{{ milestone.title }}</h3><p>{{ milestone.status }} · {{ milestone.target_period }} · {{ milestone.stream }}</p><p>{{ milestone.get('outcome', '') }}</p><p>Epics: {{ milestone.epic_ids | join(', ') or 'None' }}</p></article>{% endfor %}</section></noscript>
  </main>
  <dialog id="settings-dialog" class="settings-dialog" aria-labelledby="settings-title" aria-describedby="settings-description">
    <div class="settings-head"><div><h2 id="settings-title">Display settings</h2><p id="settings-description">Choose the extra context you want to see.</p></div><button class="close-detail" id="close-settings" type="button" aria-label="Close display settings" autofocus>×</button></div>
    <div class="settings-body">
      <label class="setting-row"><span><strong>Count cards</strong><small>Milestones, delivered outcomes, items needing attention, and epics.</small></span><input id="display-counts" type="checkbox" aria-label="Count cards" aria-controls="metrics"></label>
      <label class="setting-row"><span><strong>Search and filters</strong><small>Find milestones by stream, team, status, period, or epic.</small></span><input id="display-filters" type="checkbox" aria-label="Search and filters" aria-controls="filters"></label>
      <label class="setting-row"><span><strong>Programme health</strong><small>Overall health and the latest assessment.</small></span><input id="display-health" type="checkbox" aria-label="Programme health" aria-controls="health-card"></label>
      <label class="setting-row"><span><strong>Plan summary</strong><small>The short description below the plan title.</small></span><input id="display-summary" type="checkbox" aria-label="Plan summary" aria-controls="plan-summary"></label>
      <p class="settings-note">Applies across all three views until you reload this page. Active filters remain applied when their controls are hidden.</p>
    </div>
    <div class="settings-footer"><button class="button" id="hide-all-panels" type="button">Hide all</button><button class="button primary" id="done-settings" type="button">Done</button></div>
  </dialog>
  <dialog id="milestone-dialog" aria-labelledby="detail-title"><div id="detail-content"></div></dialog>
  <script type="application/json" id="plan-data">{{ payload | safe }}</script>
  <script>{{ js | safe }}</script>
</body>
</html>
