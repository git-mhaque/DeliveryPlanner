<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="description" content="{{ plan.get('summary', 'Multi-team delivery plan') }}">
  <title>{{ plan.title }}</title>
  <style>{{ css | safe }}</style>
</head>
<body>
  <a class="skip-link" href="#view-content">Skip to plan</a>
  <header class="topbar">
    <div class="wordmark"><span class="brand-icon" aria-hidden="true">✳</span><span>DELIVERY OFFICE</span></div>
    <div class="topbar-right"><span class="snapshot-label">REPORTING SNAPSHOT</span><span id="report-date">{{ plan.as_of or 'Draft' }}</span><button class="button subtle" id="print-button" type="button"><span aria-hidden="true">↗</span> Print / PDF</button></div>
  </header>
  <main class="workspace">
    <section class="hero" aria-labelledby="plan-title">
      <div class="hero-copy"><div class="eyebrow"><span class="tiny-star" aria-hidden="true">✦</span> PROGRAMME ROADMAP <span class="separator">/</span> <span id="horizon-label"></span></div><h1 id="plan-title">{{ plan.title }}</h1><p class="hero-summary">{{ plan.get('summary', 'Your outcomes, teams, and dependencies in one place.') }}</p></div>
      <div class="health-card" id="health-card"></div>
    </section>
    <section class="metrics" aria-label="Full plan milestone counts" id="metrics"></section>
    <div class="navigation-row">
      <nav class="view-tabs" role="tablist" aria-label="Plan views">
        <button type="button" id="tab-delivery" role="tab" data-view="delivery" aria-controls="view-content">▦ <span>Delivery View</span></button>
        <button type="button" id="tab-executive" role="tab" data-view="executive" aria-controls="view-content">◈ <span>Executive View</span></button>
        <button type="button" id="tab-backlog_epic" role="tab" data-view="backlog_epic" aria-controls="view-content">☷ <span>Backlog Epic View</span></button>
      </nav>
      <span class="navigation-note">One plan. Three perspectives.</span>
    </div>
    <form class="filters" id="filters" aria-label="Filter milestones" onsubmit="return false">
      <label class="search-filter"><span>SEARCH</span><input id="filter-search" type="search" placeholder="Milestone, outcome or epic…" autocomplete="off"></label>
      <label><span>STREAM</span><select id="filter-stream"><option value="">All streams</option></select></label>
      <label><span>TEAM</span><select id="filter-team"><option value="">All teams</option></select></label>
      <label><span>STATUS</span><select id="filter-status"><option value="">All statuses</option></select></label>
      <label><span>SCOPE</span><select id="filter-tag"><option value="">All work</option></select></label>
      <label><span>PERIOD</span><select id="filter-period"><option value="">All periods</option></select></label>
      <label><span>EPIC</span><select id="filter-epic"><option value="">All epics</option></select></label>
      <button class="button reset-button" id="reset-filters" type="button">Reset</button>
    </form>
    <div id="filter-summary" class="filter-summary" aria-live="polite"></div>
    <section id="view-content" role="tabpanel" tabindex="-1"></section>
    <details id="diagnostics" class="diagnostics"></details>
    <footer class="page-footer"><span>DELIVERY PLANNER <span class="footer-divider">/</span> A shared view of what comes next.</span><span>Renderer {{ version }} · Source {{ fingerprint[:12] }}</span></footer>
    <noscript><section class="no-script"><h2>Milestone register</h2><p>Enable JavaScript for filters, interactive views, and dependency exploration. All data is embedded in this file.</p>{% for milestone in data.milestones %}<article><h3>{{ milestone.title }}</h3><p>{{ milestone.status }} · {{ milestone.target_period }} · {{ milestone.stream }}</p><p>{{ milestone.get('outcome', '') }}</p><p>Epics: {{ milestone.epic_ids | join(', ') or 'None' }}</p></article>{% endfor %}</section></noscript>
  </main>
  <dialog id="milestone-dialog" aria-labelledby="detail-title"><div id="detail-content"></div></dialog>
  <script type="application/json" id="plan-data">{{ payload | safe }}</script>
  <script>{{ js | safe }}</script>
</body>
</html>
